{
  "name": "@Splinterjke/ompweb",
  "version": "5.1.9",
  "description": "Web UI for the oh-my-pi (omp) coding agent",
  "homepage": "https://github.com/Splinterjke/ompweb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Splinterjke/ompweb.git"
  },
  "bugs": {
    "url": "https://github.com/Splinterjke/ompweb/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "ompweb": "bin/omp-web.js",
    "ompweb-desktop": "bin/omp-web-desktop.js"
  },
  "files": [
    "bin",
    "lib",
    "app/api",
    "app/fonts/*-OFL.txt",
    "app/fonts/*-LICENSE.*",
    "server",
    "dist",
    "public",
    "scripts",
    "proxy.ts",
    "instrumentation.node.ts",
    "templates",
    "vendor/vscode-git-graph/types.ts",
    "tsconfig.json",
    "package.json"
  ],
  "scripts": {
    "dev": "bun --hot server/dev.ts -H 127.0.0.1 -p 30178",
    "dev:lan": "bun --hot server/dev.ts -H 0.0.0.0 -p 30178",
    "build": "bun scripts/build-client.ts",
    "build:binary": "npm run build && bun scripts/build-binary.ts",
    "start": "bun server/main.ts -H 127.0.0.1 -p 30177",
    "start:lan": "bun server/main.ts -H 0.0.0.0 -p 30177",
    "test": "node scripts/audit-client-api.mjs --check && bun test --parallel --timeout 30000",
    "git-graph:build": "node scripts/build-git-graph.mjs",
    "bench:session": "node scripts/perf-session-bench.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepack": "npm run build",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run build && bun scripts/smoke.ts",
    "desktop:start": "electron .",
    "desktop:build": "npm run build && electron-builder --mac",
    "desktop:build:win": "npm run build && electron-builder --win",
    "desktop:build:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "bun": "1.4.4",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.6.3",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.39.0",
    "mammoth": "^1.12.2",
    "mdast-util-find-and-replace": "^3.0.2",
    "mermaid": "^11.17.2",
    "node-pty": "^1.2.0-beta.15",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.4",
    "undici": "8.10.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "yaml": "^2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "1.4.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "bun-plugin-tailwind": "0.1.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "typescript-language-server": "^6.0.0"
  },
  "main": "desktop/main.js",
  "build": {
    "appId": "io.github.Splinterjke.ompweb",
    "productName": "OmpWeb",
    "files": [
      "desktop/**",
      "bin/**",
      "package.json",
      "public/**"
    ],
    "asarUnpack": [
      "node_modules/bun/**",
      "node_modules/@oven/**"
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "public/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "OmpWeb",
      "artifactName": "OmpWeb-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "executableName": "ompweb"
    },
    "extraResources": [
      {
        "from": "dist",
        "to": "standalone/dist"
      },
      {
        "from": "server",
        "to": "standalone/server"
      },
      {
        "from": "lib",
        "to": "standalone/lib"
      },
      {
        "from": "app/api",
        "to": "standalone/app/api"
      },
      {
        "from": "public",
        "to": "standalone/public"
      },
      {
        "from": "tsconfig.json",
        "to": "standalone/tsconfig.json"
      },
      {
        "from": "proxy.ts",
        "to": "standalone/proxy.ts"
      },
      {
        "from": "instrumentation.node.ts",
        "to": "standalone/instrumentation.node.ts"
      },
      {
        "from": "bin/request-peer.js",
        "to": "standalone/bin/request-peer.js"
      },
      {
        "from": "vendor/vscode-git-graph/types.ts",
        "to": "standalone/vendor/vscode-git-graph/types.ts"
      },
      {
        "from": "templates/desktop/splash.mp4",
        "to": "splash.mp4"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Splinterjke",
        "repo": "ompweb",
        "private": false
      }
    ],
    "npmRebuild": false
  },
  "author": "Splinterjke",
  "allowScripts": {
    "bun@1.4.4": true
  }
}
