{
	"compilerOptions": {
		"lib": [
			"es6",
			"dom"
		],
		"module": "none",
		"moduleResolution": "node",
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "../../../build/git-graph-web",
		"removeComments": true,
		"strict": true,
		"target": "es6"
	}
}